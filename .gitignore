# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules/
/frontend/node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/frontend/coverage/

# Next.js & Frontend build output
/.next/
/out/
/frontend/.next/
/frontend/out/
frontend/next-env.d.ts

# production & dist
/build/
/dist/

# misc
.DS_Store
Thumbs.db
*.pem

# debug & logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
*.log

# env files (allow .env.example)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo

# build artifacts & packages
qmanager-build/
qmanager_install/
RELEASE_NOTE.md

# Go build artifacts & binaries
qmanager-armv7*
/qmanager-armv7
/backend/qmanager*
/backend/cmd/qmanager/dist/*
!/backend/cmd/qmanager/dist/index.html
backend/*.exe
*.exe
*.test
*.prof

# claude / IDE / tools
/.superpowers
/.claude
/.vscode/
/.idea/
/.slim/deepwork/

# simpleadmin source & scratch
/simpleadmin-source
/tools/
/health-checks/
/scratch/
/reimagine/
/scripts-dev/rescue/
/.playwright-mcp
